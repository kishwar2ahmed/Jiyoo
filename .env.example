# ==============================================================================
# JIYOO — Environment Variable Template (DO NOT COMMIT REAL SECRETS HERE)
# ==============================================================================

# --- Client-Side Firebase Web SDK (Public, prefixed with VITE_) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Server-Side Runtime & Firebase Admin SDK (Private) ---
PORT=3000
NODE_ENV=development
FIREBASE_PROJECT_ID=
# JSON string or base64-encoded service account key for Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_KEY=
# Comma-separated bootstrap admin email(s) synced to custom claims on startup
ADMIN_EMAILS=

# --- Payment Gateway (Razorpay — Server-Side Only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Scheduled Reconciliation Cron Secret (Server-Side Only) ---
CRON_SECRET=

# --- Transactional Order Email (SMTP — Server-Side Only) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="JIYOO <noreply@example.com>"
