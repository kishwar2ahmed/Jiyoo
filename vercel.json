{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{api/_server.cjs,.server-data/store-db.json,firebase-applet-config.json}",
      "excludeFiles": "{public/**,dist/**,.git/**,*.log}"
    },
    "api/[...path].ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{api/_server.cjs,.server-data/store-db.json,firebase-applet-config.json}",
      "excludeFiles": "{public/**,dist/**,.git/**,*.log}"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/seo/robots.txt"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reconcile",
      "schedule": "*/10 * * * *"
    }
  ]
}
