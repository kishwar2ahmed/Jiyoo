{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/[...path].ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/seo/robots.txt"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reconcile",
      "schedule": "*/10 * * * *"
    }
  ]
}
