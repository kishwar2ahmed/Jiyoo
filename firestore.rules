rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Authoritative admin check: a server-controlled Firebase Auth custom
    // claim, set only via the Admin SDK (see server.ts syncAdminClaims() and
    // POST /api/admin/users/:uid/role). Custom claims live inside the
    // caller's signed ID token, so this can never be influenced by
    // client-writable data such as a Firestore "role" field, localStorage,
    // or anything else the client controls.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email_verified == true &&
          request.auth.token.email in [
            'yoyokishwar@gmail.com',
            'shamsjiyoo@gmail.com',
            'jiyooshams@gmail.com',
            'syedshams7799@gmail.com',
            'kishwar.ahmed.vr@gmail.com'
          ])
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // A self-created profile doc can never claim role "admin" or admin==true --
      // real admin status only ever comes from the custom claim above.
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        request.resource.data.keys().size() <= 20 &&
        request.resource.data.get('role', 'user') != 'admin' &&
        request.resource.data.get('admin', false) == false &&
        (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 200)) &&
        (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 200)) &&
        (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30)) &&
        (!('picture' in request.resource.data) || request.resource.data.picture == null || (request.resource.data.picture is string && request.resource.data.picture.size() <= 500000));
      // Admins may update any profile (role changes are actually granted via
      // the /api/admin/users/:uid/role endpoint, which sets the real custom
      // claim through the Admin SDK and mirrors this field for display).
      // A user updating their own doc may never change their own role or admin flag.
      allow update: if isAdmin() ||
        (isOwner(userId) &&
          isValidId(userId) &&
          request.resource.data.keys().size() <= 20 &&
          request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
          request.resource.data.get('admin', false) == resource.data.get('admin', false) &&
          request.resource.data.get('email', resource.data.get('email', '')) == resource.data.get('email', '') &&
          (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 200)) &&
          (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30)) &&
          (!('picture' in request.resource.data) || request.resource.data.picture == null || (request.resource.data.picture is string && request.resource.data.picture.size() <= 500000)));
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) &&
          isValidId(addressId) &&
          request.resource.data.keys().size() <= 20 &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
          request.resource.data.address is string &&
          request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 500 &&
          request.resource.data.pincode is string && request.resource.data.pincode.size() <= 12 &&
          (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30));
      }
    }

    match /products/{productId} {
      allow read: if true;
      // Prices/inventory can only be changed by an admin. Checkout never
      // trusts client-sent prices/stock anyway -- server.ts always
      // recomputes both authoritatively from these documents.
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      // Never publicly listable/readable -- storefront validation happens
      // server-side via /api/coupons/validate, which returns only
      // { valid, discount, ... } and never the coupon documents themselves.
      allow read: if isAdmin();
      allow write: if isAdmin();

      match /redemptions/{userId} {
        allow read, write: if false;
      }
    }

    match /inventoryReservations/{reservationId} {
      allow read, write: if false;
    }

    match /razorpayPendingOrders/{orderId} {
      allow read, write: if false;
    }

    match /razorpayWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /idempotencyKeys/{keyId} {
      allow read, write: if false;
    }

    match /admin_security/{emailKey} {
      // Server-only TOTP 2FA secrets, recovery code hashes, and brute-force
      // lockout counters. Never readable or writable by any client.
      allow read, write: if false;
    }

    match /admin_sessions/{jti} {
      // Server-only 2FA-verified admin session registry.
      allow read, write: if false;
    }

    match /_images/{imageId} {
      allow read, write: if false;
    }

    match /media_uploads/{fileId} {
      // Server-only binary media persistence mirror for billing-free uploads.
      allow read, write: if false;
    }

    match /settings/{settingId} {
      // No secrets are ever stored in Firestore settings docs -- Razorpay,
      // SMTP, and Firebase Admin credentials live only in server-side
      // environment variables (see server.ts envSchema). This collection is
      // storefront display config (store name, delivery fee, UPI id, about
      // us copy...), so public read is intentional and safe.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Orders (and all status, payment, refund, and tracking modifications)
      // are ONLY ever written by the trusted server via the Admin SDK, which
      // atomically records a tamper-evident server-side audit log entry in
      // /orders/{orderId}/audit_logs/{logId} and /audit_logs/{logId}.
      // Disallowing all client-side writes (including manual client SDK
      // updates by admins) prevents any modification from bypassing server
      // state-machine validation and the immutable audit log.
      allow create, update, delete: if false;

      match /audit_logs/{logId} {
        // Append-only server-side order audit trail. Admins and the order
        // owner may inspect the audit history; no client may ever write,
        // modify, or delete an order audit record.
        allow read: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid);
        allow write: if false;
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // Reviews are created only by the verified-purchase server endpoint.
      allow create, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      // Admin-panel-only collection; no client write path exists in the app.
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /audit_logs/{logId} {
      // Server-controlled, append-only. Only the Admin SDK (via
      // POST /api/admin/audit-log) may write, which bypasses these rules
      // entirely. No client -- including an authenticated admin -- may
      // create, edit, or delete audit history through the client SDK.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /deliveryPincodes/{pincode} {
      // Never publicly listable -- the brief requires no public list of
      // delivery localities. Checkout validates serviceability through
      // POST /api/delivery/check-pincode (one pincode at a time, no list
      // returned). Writes go only through the admin-only, audit-logged
      // /api/admin/delivery/pincodes endpoints (Admin SDK bypasses rules),
      // so this collection has no client write path at all.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /wholesaleZones/{zoneId} {
      // Same reasoning as deliveryPincodes: admin-only read, server-only
      // write via the audit-logged admin endpoints.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /banners/{bannerId} {
      // Marketing content, not a security-sensitive gate like delivery or
      // pricing -- managed the same way as categories/products (direct
      // admin client writes). Public-facing display never reads this
      // collection directly; the storefront calls GET /api/banners/active,
      // which applies the publish/schedule window server-side so
      // draft/expired/unpublished campaigns are never exposed to customers.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
