rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Authoritative admin check: a server-controlled Firebase Auth custom
    // claim, set only via the Admin SDK (see server.ts syncAdminClaims() and
    // POST /api/admin/users/:uid/role). Custom claims live inside the
    // caller's signed ID token, so this can never be influenced by
    // client-writable data such as a Firestore "role" field, localStorage,
    // or anything else the client controls.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // A self-created profile doc can never claim role "admin" -- real
      // admin status only ever comes from the custom claim above.
      allow create: if isOwner(userId) &&
        request.resource.data.get('role', 'user') != 'admin';
      // Admins may update any profile (role changes are actually granted via
      // the /api/admin/users/:uid/role endpoint, which sets the real custom
      // claim through the Admin SDK and mirrors this field for display).
      // A user updating their own doc may never change their own role.
      allow update: if isAdmin() ||
        (isOwner(userId) &&
          request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
          request.resource.data.get('email', resource.data.get('email', '')) == resource.data.get('email', ''));
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
          request.resource.data.address is string &&
          request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 500 &&
          request.resource.data.pincode is string && request.resource.data.pincode.size() <= 12 &&
          (!('phone' in request.resource.data) || request.resource.data.phone is string);
      }
    }

    match /products/{productId} {
      allow read: if true;
      // Prices/inventory can only be changed by an admin. Checkout never
      // trusts client-sent prices/stock anyway -- server.ts always
      // recomputes both authoritatively from these documents.
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      // Never publicly listable/readable -- storefront validation happens
      // server-side via /api/coupons/validate, which returns only
      // { valid, discount, ... } and never the coupon documents themselves.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      // No secrets are ever stored in Firestore settings docs -- Razorpay,
      // SMTP, and Firebase Admin credentials live only in server-side
      // environment variables (see server.ts envSchema). This collection is
      // storefront display config (store name, delivery fee, UPI id, about
      // us copy...), so public read is intentional and safe.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Orders (and payment/order status) are only ever written by the
      // trusted server via the Admin SDK, which bypasses these rules --
      // customers can never create an order or touch payment/order status
      // directly through the client SDK.
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // Reviews are created only by the verified-purchase server endpoint.
      allow create, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      // Admin-panel-only collection; no client write path exists in the app.
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /audit_logs/{logId} {
      // Server-controlled, append-only. Only the Admin SDK (via
      // POST /api/admin/audit-log) may write, which bypasses these rules
      // entirely. No client -- including an authenticated admin -- may
      // create, edit, or delete audit history through the client SDK.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
